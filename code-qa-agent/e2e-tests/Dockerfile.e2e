FROM python:3.12-slim

# 国内镜像源
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources

# Install OS dependencies (same as bootstrap-python.sh)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ripgrep && \
    rm -rf /var/lib/apt/lists/*

# Create venv with Python dependencies
# Matches what bootstrap-python.sh installs: requirements.txt + watchfiles
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r /tmp/requirements.txt

# Write stamp file so bootstrap-python.sh skips pip install when requirements.txt hasn't changed
RUN cd /tmp && printf '%s' "$(sha256sum requirements.txt | awk '{print $1}')" > /opt/venv/.requirements.sha256 && \
    rm /tmp/requirements.txt

WORKDIR /app
