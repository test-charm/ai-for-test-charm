FROM python:3.12-slim

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources

WORKDIR /app

ENV HF_HOME=/app/.cache/huggingface
ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

COPY e2e-tests/embedding_requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --default-timeout=120 --retries 5 \
    torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir --default-timeout=120 --retries 5 \
    -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

COPY e2e-tests/embedding_server.py /app/

EXPOSE 8001

CMD ["uvicorn", "embedding_server:app", "--host", "0.0.0.0", "--port", "8001"]
